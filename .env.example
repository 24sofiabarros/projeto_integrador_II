# ==============================================================================
# SITRIB - SISTEMA DE INTELIGÊNCIA TRIBUTÁRIA (SEFIN PALMAS-TO)
# Modelo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (cp .env.example .env)
# 2. Preencha as credenciais e configurações institucionais.
# 3. NUNCA faça commit do arquivo .env com credenciais reais!
# ==============================================================================

# URL base da API REST da Secretaria Municipal de Finanças (Sefin Palmas)
SEFIN_API_BASE_URL=https://integracao.palmas.to.gov.br/apirest

# Token de autenticação Bearer institucional (gerado pela Sefin/Prefeitura)
SEFIN_API_TOKEN=exemplo_token_ficticio_sefin_palmas_2026

# Timeout padrão em segundos para requisições HTTP
SEFIN_API_TIMEOUT=15

# Intervalo mínimo (rate limit) em segundos entre requisições (mínimo 1.0s para consumo ético)
SEFIN_RATE_LIMIT_DELAY=1.0

# ------------------------------------------------------------------------------
# MODO DE SIMULAÇÃO REST CONTROLADA
# ------------------------------------------------------------------------------
# Caso a API da Prefeitura esteja temporariamente offline ou inacessível fora
# da rede municipal, defina como 'true' para ativar o servidor REST mock local embutido.
SEFIN_SIMULACAO_LOCAL=true
SEFIN_SIMULACAO_PORTA=8000
